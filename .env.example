# Copy to .env and fill in. The real .env is gitignored — never commit secrets.

# --- Email Bison ---
EMAILBISON_API_KEY=your-bison-api-key
EMAILBISON_BASE_URL=https://send.your-bison-instance.com

# --- HubSpot (EU region uses a pat-eu1 token but the same api.hubapi.com host) ---
HUBSPOT_ACCESS_TOKEN=pat-xxxx-your-private-app-token
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_BASE_URL=https://api.hubapi.com
# Contact property holding the LinkedIn profile URL (adjust if yours differs):
HUBSPOT_LINKEDIN_PROPERTY=hs_linkedin_url

# --- HubSpot email-activity logging (hubspot_activity_sync.py) ---
# Identity shown as the "From" on every logged email so the timeline reads as ONE
# "AI SDR" sender regardless of which Bison alias actually sent it. (No real mailbox
# needed — this is metadata on the logged activity, not an address that sends mail.)
HUBSPOT_AISDR_FROM_EMAIL=ai-sdr@everworker.ai
HUBSPOT_AISDR_FROM_NAME=AI SDR
# Optional: own these activities under a HubSpot user/owner. Leave UNSET (recommended)
# so the AI's volume doesn't inflate any human rep's activity reporting. To attribute
# them to a seat, run: hubspot_activity_sync.py --resolve-owner you@company.com
# HUBSPOT_AISDR_OWNER_ID=
# Background auto-sync (the web server logs new activity to HubSpot on a timer):
HUBSPOT_ACTIVITY_AUTOSYNC=1            # 0 to disable the background loop entirely
HUBSPOT_ACTIVITY_AUTOSYNC_MINUTES=60  # how often the cheap replies-only sync runs
HUBSPOT_ACTIVITY_AUTOSYNC_FULL=0      # 1 to also auto-log the outbound sequence (throttled)

# --- HeyReach (LinkedIn) ---
HEYREACH_API_KEY=your-heyreach-api-key
HEYREACH_BASE_URL=https://api.heyreach.io/api/public

# --- HeyReach -> HubSpot activity logging (heyreach_activity.py + the webhook) ---
# Shared secret HeyReach must include on every webhook call, as ?secret=... in the URL
# or an X-Webhook-Secret header. Generate a long random string; the webhook 401s without
# it. Point all 6 HeyReach webhooks at https://<your-host>/api/heyreach/webhook?secret=...
HEYREACH_WEBHOOK_SECRET=generate-a-long-random-string
# Background safety-net drain of the webhook inbox to HubSpot (the webhook also logs in
# near-real-time; this re-tries anything left pending/failed). 0 to disable.
HEYREACH_ACTIVITY_AUTOSYNC=1
# Reused by the LinkedIn logger too: HUBSPOT_AISDR_FROM_NAME (timeline attribution name)
# and HUBSPOT_AISDR_OWNER_ID (optional owner), both defined in the HubSpot section above.

# --- Anthropic (copy generation + Clay sourcing) ---
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Cheap model used to drive Clay MCP enrichment / contact extraction:
CLAUDE_SOURCING_MODEL=claude-haiku-4-5

# --- Clay MCP (OAuth 2.1 — connect once from the Use view; tokens auto-refresh) ---
# Tokens are stored (gitignored) in data/outreach/clay_oauth.json, never in .env.
CLAY_MCP_URL=https://api.clay.com/v3/mcp
# OAuth callback URL. Leave UNSET when deployed: the server derives it from the
# request host (honoring the proxy's X-Forwarded-* headers), so Clay always
# redirects back to wherever the console is actually served. Set it only to pin a
# specific URL for local dev / non-standard setups.
# CLAY_OAUTH_REDIRECT=http://localhost:8787/api/clay/oauth/callback

# --- Authentication (login gate) ---
# Secret used to SIGN login session tokens. Generate a long random string, e.g.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, the server generates an ephemeral one at startup and everyone is
# logged out on each restart/redeploy. Set this in production so logins persist.
# (Accepted users + passwords are baked into the app as salted hashes — not here.)
AUTH_SECRET_KEY=generate-a-long-random-string

# --- Runtime config ---
HUBSPOT_LIST_ID=0000

# Per-persona Bison email campaign IDs:
#   sales-leadership | revops | partnerships | sdr-bdr
BISON_CAMPAIGN_SALES_LEADERSHIP=10
BISON_CAMPAIGN_REVOPS=11
BISON_CAMPAIGN_PARTNERSHIPS=12
BISON_CAMPAIGN_SDR_BDR=13

# HeyReach (LinkedIn) — optional; fill to enable LinkedIn enrollment:
HEYREACH_CAMPAIGN_ID=
HEYREACH_LINKEDIN_ACCOUNT_ID=
BISON_INTERESTED_FOLLOWUP_CAMPAIGN_ID=
