# Copy to .env and fill in. The real .env is gitignored — never commit secrets.

# --- Email Bison ---
EMAILBISON_API_KEY=your-bison-api-key
EMAILBISON_BASE_URL=https://send.your-bison-instance.com

# --- HubSpot (EU region uses a pat-eu1 token but the same api.hubapi.com host) ---
HUBSPOT_ACCESS_TOKEN=pat-xxxx-your-private-app-token
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_BASE_URL=https://api.hubapi.com
# Contact property holding the LinkedIn profile URL (adjust if yours differs):
HUBSPOT_LINKEDIN_PROPERTY=hs_linkedin_url

# --- HubSpot email-activity logging (hubspot_activity_sync.py) ---
# Identity shown as the "From" on every logged email so the timeline reads as ONE
# "AI SDR" sender regardless of which Bison alias actually sent it. (No real mailbox
# needed — this is metadata on the logged activity, not an address that sends mail.)
HUBSPOT_AISDR_FROM_EMAIL=ai-sdr@everworker.ai
HUBSPOT_AISDR_FROM_NAME=AI SDR
# Optional: own these activities under a HubSpot user/owner. Leave UNSET (recommended)
# so the AI's volume doesn't inflate any human rep's activity reporting. To attribute
# them to a seat, run: hubspot_activity_sync.py --resolve-owner you@company.com
# HUBSPOT_AISDR_OWNER_ID=
# Background auto-sync (the web server logs new activity to HubSpot on a timer):
HUBSPOT_ACTIVITY_AUTOSYNC=1            # 0 to disable the background loop entirely
HUBSPOT_ACTIVITY_AUTOSYNC_MINUTES=60  # how often the replies sync runs
HUBSPOT_ACTIVITY_AUTOSYNC_FULL=1      # 1 (default) auto-logs the outbound sequence too; 0 = replies only
HUBSPOT_ACTIVITY_AUTOSYNC_FULL_EVERY=12  # include the outbound sweep on every Nth cycle

# --- AI SDR deal attribution (nightly HubSpot -> MongoDB sync) ---
# MongoDB connection string. On Railway: add the MongoDB service to the SAME project +
# environment as sdr-console, then on the sdr-console service add a variable
#   MONGO_URL=${{MongoDB.MONGO_URL}}   (type "${{" and pick your Mongo service — its
# name may differ). Unset = feature off: the Analytics tiles show a dash with a setup
# hint and the nightly job self-disables. Reading email engagements also needs the
# sales-email-read scope on the HubSpot private app token.
# MONGO_URL=
AISDR_SYNC_ENABLED=1     # 0 disables the nightly job (manual "Sync attribution" still works)
AISDR_SYNC_HOUR=0        # hour of day in America/New_York (0 = midnight Eastern)
# AISDR_MONGO_DB=aisdr   # override the Mongo database name

# --- Unenrollment checker (everworker_tag suppression sweeps) ---------------
# RevOps maintains the HubSpot CONTACT property everworker_tag: when it is "false"
# the AI SDR must leave the contact alone — never enroll them, and stop any active
# Email Bison / HeyReach sequence (campaign-scoped stop-future-emails /
# StopLeadInCampaign). The web server sweeps every UNENROLL_CHECK_MINUTES;
# enrollment also checks the tag live at pull + enroll time. Every action lands in
# the unenrollment_log ledger (pipeline.db) and, when a sequence was actually
# stopped, as a note on the contact's HubSpot timeline.
UNENROLL_CHECK_ENABLED=1   # 0 disables the background sweeper (manual "Run now" still works)
UNENROLL_CHECK_MINUTES=30
UNENROLL_RECHECK_HOURS=24  # re-verify already-handled contacts this often (0 = every sweep)
UNENROLL_HUBSPOT_NOTE=1    # 0 = skip the timeline note on stopped contacts
# HUBSPOT_EVERWORKER_TAG_PROPERTY=everworker_tag   # override if RevOps renames the property

# --- HeyReach (LinkedIn) ---
HEYREACH_API_KEY=your-heyreach-api-key
HEYREACH_BASE_URL=https://api.heyreach.io/api/public

# --- HeyReach -> HubSpot activity logging (heyreach_activity.py + the webhook) ---
# Shared secret HeyReach must include on every webhook call, as ?secret=... in the URL
# or an X-Webhook-Secret header. Generate a long random string; the webhook 401s without
# it. Point all 6 HeyReach webhooks at https://<your-host>/api/heyreach/webhook?secret=...
HEYREACH_WEBHOOK_SECRET=generate-a-long-random-string
# Background safety-net drain of the webhook inbox to HubSpot (the webhook also logs in
# near-real-time; this re-tries anything left pending/failed). 0 to disable.
HEYREACH_ACTIVITY_AUTOSYNC=1
# Reused by the LinkedIn logger too: HUBSPOT_AISDR_FROM_NAME (timeline attribution name)
# and HUBSPOT_AISDR_OWNER_ID (optional owner), both defined in the HubSpot section above.

# --- Anthropic (copy generation + Clay sourcing) ---
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Cheap model used to drive Clay MCP enrichment / contact extraction:
CLAUDE_SOURCING_MODEL=claude-haiku-4-5

# --- Clay MCP (OAuth 2.1 — connect once from the Use view; tokens auto-refresh) ---
# Tokens are stored (gitignored) in data/outreach/clay_oauth.json, never in .env.
CLAY_MCP_URL=https://api.clay.com/v3/mcp
# OAuth callback URL. Leave UNSET when deployed: the server derives it from the
# request host (honoring the proxy's X-Forwarded-* headers), so Clay always
# redirects back to wherever the console is actually served. Set it only to pin a
# specific URL for local dev / non-standard setups.
# CLAY_OAUTH_REDIRECT=http://localhost:8787/api/clay/oauth/callback

# --- Authentication (login gate) ---
# Secret used to SIGN login session tokens. Generate a long random string, e.g.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, the server generates an ephemeral one at startup and everyone is
# logged out on each restart/redeploy. Set this in production so logins persist.
# (Accepted users + passwords are baked into the app as salted hashes — not here.)
AUTH_SECRET_KEY=generate-a-long-random-string

# --- Runtime config ---
HUBSPOT_LIST_ID=0000

# Per-persona Bison email campaign IDs:
#   sales-leadership | revops | partnerships | sdr-bdr
BISON_CAMPAIGN_SALES_LEADERSHIP=10
BISON_CAMPAIGN_REVOPS=11
BISON_CAMPAIGN_PARTNERSHIPS=12
BISON_CAMPAIGN_SDR_BDR=13

# HeyReach (LinkedIn) — optional; fill to enable LinkedIn enrollment:
HEYREACH_CAMPAIGN_ID=
HEYREACH_LINKEDIN_ACCOUNT_ID=
BISON_INTERESTED_FOLLOWUP_CAMPAIGN_ID=

# --- Replies safety guards + Signal Playbook Reply Agent -------------------
# Fresh-ledger guard: if the HubSpot activity ledger is EMPTY and a live sync
# would create more than this many engagements, the sync refuses (dry-run) —
# protects HubSpot from duplicate storms after a wiped /app/data volume.
# Recover with: hubspot_activity_sync.py --reconcile-from-hubspot (adopts the
# existing engagements into the ledger), or --allow-backfill for an intentional
# first backfill.
HUBSPOT_ACTIVITY_FRESH_MAX=50
# Intentional first backfill on a brand-new deployment (empty ledger + more than
# FRESH_MAX events to log): set to 1 so the hourly autosync passes --allow-backfill.
# Unset it again once the first sync has seeded the ledger.
# HUBSPOT_ACTIVITY_ALLOW_BACKFILL=1

# Signal Playbook Reply Agent (Replies view agent dropdown):
# - needs ANTHROPIC_API_KEY (research + drafting, defined above)
# - needs HUBSPOT_ACCESS_TOKEN with the *content* scope (CMS pages: the play
#   publishes as a LIVE website page at everworker.ai/signal-plays/<company>-ai-sdr-playbook
#   via create-draft + push-live; rebuilds republish the same URL)
# Optional overrides:
# SIGNAL_PLAY_DOMAIN=www.everworker.ai   # publish domain (default: portal primary)
SIGNAL_PLAY_NOINDEX=1                    # 0 to let search engines index play pages
# Only for the optional manual/local PDF export (not used by the pipeline):
# DECK_CHROMIUM_PATH=/usr/bin/chromium

# --- Technographic detection (vendored technographics/ + tech_signals.py) ---
# DNS + static-HTML fingerprinting of each account's website: which CRM, ad
# pixels, martech, salestech they run. Runs inline with account research (cache
# miss), from the Signals view (per-row Detect + bulk "Detect missing"), before
# each signal-play research call, and as a tail after Message-Batches complete.
# Results land in account_signals.tech_* (SQLite) and, when enabled, in the
# HubSpot company property `technographic_signals`. Needs dnspython
# (requirements.txt); without it the feature reports unavailable and everything
# else keeps working. Scans are reused for TECH_REFRESH_DAYS.
TECH_DETECT_ENABLED=1        # 0 = no automatic scans during generation/research (UI + CLI still work)
TECH_HUBSPOT_WRITEBACK=1     # 0 = never PATCH the HubSpot company property
# TECH_REFRESH_DAYS=90       # scans older than this are re-run on next touch
# TECH_DNS_TIMEOUT=3.0       # seconds per DNS lookup batch
# TECH_FETCH_TIMEOUT=10      # seconds for the static page fetch
# Vendor scope: which of the catalogue's 7.5k vendors to match (default = the
# curated ~65 marketing/sales set). Pointing this at a huge selection makes
# every scan slower (whole-page regex per web signature).
# TECH_SELECTION_FILE=technographics/signatures/selection.marketing_sales.json

# --- Hiring signals (Prospeo job-postings scan + hiring_signals.py) ----------
# Detects whether an account is hiring — especially sales/GTM roles — via the
# Prospeo enrich-company API. Runs inline with account research (cache miss),
# from the Signals view (drawer "Detect hiring" + bulk "Detect hiring"), and as
# a tail after Message-Batches complete. Results land in
# account_signals.hiring_* (SQLite) and, when enabled, in the HubSpot company
# properties open_roles_count / hiring_signals_job_titles / hiring_signals
# (the same three the hubspot-hiring-signals job maintains). Copy generation
# opens EMAIL 2 on the signal when open sales roles are found. Without
# PROSPEO_API_KEY the feature reports unavailable and everything else keeps
# working. Each non-cached scan costs ONE Prospeo credit; results are reused
# for HIRING_REFRESH_DAYS — prefer --limit on a first bulk backfill.
PROSPEO_API_KEY=
HIRING_DETECT_ENABLED=1      # 0 = no automatic scans during generation/research (UI + CLI still work)
HIRING_HUBSPOT_WRITEBACK=1   # 0 = never PATCH the HubSpot company properties
# HIRING_REFRESH_DAYS=90     # scans older than this are re-run on next touch
