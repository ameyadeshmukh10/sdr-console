# Copy to .env and fill in. The real .env is gitignored — never commit secrets.

# --- Email Bison ---
EMAILBISON_API_KEY=your-bison-api-key
EMAILBISON_BASE_URL=https://send.your-bison-instance.com

# --- HubSpot (EU region uses a pat-eu1 token but the same api.hubapi.com host) ---
HUBSPOT_ACCESS_TOKEN=pat-xxxx-your-private-app-token
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_BASE_URL=https://api.hubapi.com
# Contact property holding the LinkedIn profile URL (adjust if yours differs):
HUBSPOT_LINKEDIN_PROPERTY=hs_linkedin_url

# --- HeyReach (LinkedIn) ---
HEYREACH_API_KEY=your-heyreach-api-key
HEYREACH_BASE_URL=https://api.heyreach.io/api/public

# --- Runtime config ---
HUBSPOT_LIST_ID=0000

# Per-persona Bison email campaign IDs:
#   sales-leadership | revops | partnerships | sdr-bdr
BISON_CAMPAIGN_SALES_LEADERSHIP=10
BISON_CAMPAIGN_REVOPS=11
BISON_CAMPAIGN_PARTNERSHIPS=12
BISON_CAMPAIGN_SDR_BDR=13

# HeyReach (LinkedIn) — optional; fill to enable LinkedIn enrollment:
HEYREACH_CAMPAIGN_ID=
HEYREACH_LINKEDIN_ACCOUNT_ID=
